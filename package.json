{
  "name": "gtd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,gray \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "demo": "GTD_DATA_DIR=data-demo npm run dev",
    "demo:seed": "GTD_DATA_DIR=data-demo node tests/seed-demo.mjs",
    "test:firefox": "node tests/firefox-keys.mjs",
    "auth:setup": "tsx --env-file-if-exists=.env server/auth-setup.ts",
    "backup": "node scripts/backup.mjs",
    "calendar:find": "tsx --env-file-if-exists=.env scripts/calendar-find.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "mailparser": "^3.9.28",
    "mammoth": "^1.12.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "selenium-webdriver": "^4.49.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
