# Add this block to /etc/caddy/Caddyfile. Caddy fetches and renews the HTTPS certificate itself.
gtd.rikard.me {
	encode zstd gzip
	request_body {
		max_size 50MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 300s
		}
	}
}
